#!/usr/bin/env bash
set -euo pipefail

TARGET="/mnt"
DEFAULT_REPO_URL="${SOLACE_REPO_URL:-}"
DEMO="${SOLACE_INSTALL_DEMO:-0}"

if [[ -z "${TERM:-}" || "${TERM:-}" == "dumb" ]]; then
  export TERM="xterm-256color"
fi

if [[ "${1:-}" == "--demo" ]]; then
  DEMO=1
  shift
fi

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  cat <<'EOF'
Usage: solace-install [--demo]

Launches the Solace installer menu.

Options:
  --demo    Run without making system changes or launching external installers.
EOF
  exit 0
fi

has_gum() {
  command -v gum >/dev/null 2>&1
}

say() {
  if has_gum; then
    gum style --foreground 81 --bold "$*"
  else
    printf '%s\n' "$*"
  fi
}

note() {
  if has_gum; then
    gum style --foreground 245 "$*"
  else
    printf '%s\n' "$*"
  fi
}

fail() {
  if has_gum; then
    gum style --foreground 196 --bold "ERROR: $*" >&2
  else
    printf 'ERROR: %s\n' "$*" >&2
  fi
  exit 1
}

confirm() {
  local prompt="$1"
  if has_gum; then
    gum confirm "$prompt"
  else
    read -r -p "$prompt [y/N] " answer
    [[ "$answer" =~ ^[Yy]([Ee][Ss])?$ ]]
  fi
}

choose() {
  if has_gum; then
    gum choose "$@"
  else
    local i=1 choice
    local choices=("$@")
    for choice in "$@"; do
      printf '%d) %s\n' "$i" "$choice"
      i=$((i + 1))
    done
    read -r -p "Choose: " choice
    [[ "$choice" =~ ^[0-9]+$ ]] || return 1
    [[ "$choice" -ge 1 && "$choice" -le "${#choices[@]}" ]] || return 1
    printf '%s\n' "${choices[$((choice - 1))]}"
  fi
}

input() {
  local prompt="$1"
  local placeholder="${2:-}"
  if has_gum; then
    gum input --prompt "$prompt" --placeholder "$placeholder"
  else
    read -r -p "$prompt" value
    printf '%s\n' "$value"
  fi
}

header() {
  clear
  if has_gum; then
    gum style \
      --border rounded \
      --border-foreground 81 \
      --padding "1 3" \
      --margin "1 0" \
      --foreground 255 \
      --background 17 \
      --bold \
      "Solace Installer"
  else
    printf '== Solace Installer ==\n'
  fi
}

show_storage() {
  note "Detected block devices:"
  lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS
  printf '\n'
}

pause() {
  if has_gum; then
    gum input --placeholder "Press Enter to continue" >/dev/null
  else
    read -r -p "Press Enter to continue"
  fi
}

demo_notice() {
  [[ "$DEMO" == "1" ]] || return 0
  if has_gum; then
    gum style --foreground 229 --background 94 --padding "0 1" "DEMO MODE: no install actions will run."
  else
    printf 'DEMO MODE: no install actions will run.\n'
  fi
  printf '\n'
}

show_install_guide() {
  header
  say "Install guide"
  printf '\n'
  note "1. Download the newest Solace ISO from the latest release."
  note "2. Flash it to a USB drive with a tool like Fedora Media Writer, Balena Etcher, or dd."
  note "3. Boot the target computer from the USB stick."
  note "4. Connect to the internet. Ethernet should work automatically; Wi-Fi can use iwctl."
  note "5. Choose an install path:"
  note "   - Fast path: use archinstall, then let this menu stage Solace into the target."
  note "   - Manual path: partition/mount yourself at /mnt, then stage or run Solace bootstrap."
  note "   - Experimental path: try Calamares while it is still being developed."
  note "6. Reboot, log in, and accept the Solace post-install prompt."
  printf '\n'
  pause
}

require_target_mount() {
  mountpoint -q "$TARGET" || fail "$TARGET is not mounted."
  [[ -d "$TARGET/etc" ]] || fail "$TARGET does not look like an installed Linux root. Missing $TARGET/etc."
  [[ -d "$TARGET/boot" || -d "$TARGET/efi" ]] || note "No obvious boot mount found under $TARGET. Continuing anyway."
}

copy_or_clone_solace() {
  local target_repo="$TARGET/opt/solace"
  local repo_url="$DEFAULT_REPO_URL"
  local embedded_repo="/opt/solace"

  mkdir -p "$TARGET/opt"

  if [[ -d "$target_repo/.git" || -f "$target_repo/install.sh" ]]; then
    note "Using existing Solace checkout at $target_repo"
    return 0
  fi

  if [[ -f "$embedded_repo/install.sh" ]]; then
    note "Copying embedded Solace repo from $embedded_repo to $target_repo"
    rsync -a --delete "$embedded_repo/" "$target_repo/"
    return 0
  fi

  repo_url="$(input "Solace git URL: " "${repo_url:-https://example.invalid/your/solace.git}")"
  [[ -n "$repo_url" ]] || fail "A Solace repository URL is required unless $target_repo already exists."

  command -v git >/dev/null 2>&1 || fail "git is not installed in the live image."
  git clone "$repo_url" "$target_repo"
}

target_login_user() {
  awk -F: '$3 >= 1000 && $3 < 60000 && $6 ~ /^\/home\// { print $1; exit }' "$TARGET/etc/passwd" 2>/dev/null || true
}

fix_staged_solace_permissions() {
  local target_repo="$TARGET/opt/solace"
  local login_user

  [[ -d "$target_repo" ]] || return 0

  find "$target_repo" -type d -exec chmod 0755 {} + 2>/dev/null || true
  find "$target_repo" -type f -name '*.sh' -exec chmod 0755 {} + 2>/dev/null || true
  chmod 0755 "$target_repo/install.sh" 2>/dev/null || true

  login_user="$(target_login_user)"
  if [[ -n "$login_user" ]]; then
    note "Giving $login_user ownership of staged Solace files"
    chroot "$TARGET" chown -R "$login_user:$login_user" /opt/solace
  else
    note "Could not detect a regular target user; leaving /opt/solace root-owned."
    note "The installer wrapper can still run with bash, but AUR setup works best after chowning /opt/solace to your user."
  fi
}

install_first_login_prompt() {
  local postinstall="$TARGET/usr/local/bin/solace-postinstall"
  local profile_hook="$TARGET/etc/profile.d/solace-first-login.sh"

  mkdir -p "$TARGET/usr/local/bin" "$TARGET/etc/profile.d"

  cat >"$postinstall" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

MARKER="${XDG_STATE_HOME:-$HOME/.local/state}/solace/postinstall.done"
SOLACE_DIR="/opt/solace"

if [[ "${1:-}" == "--prompt" ]]; then
  [[ -t 0 ]] || exit 0
  [[ -f "$MARKER" ]] && exit 0
  [[ -x "$SOLACE_DIR/install.sh" || -f "$SOLACE_DIR/install.sh" ]] || exit 0

  printf '\nSolace is staged on this system but has not been installed yet.\n'
  read -r -p "Run Solace desktop bootstrap now? [y/N] " answer
  case "$answer" in
    [Yy]|[Yy][Ee][Ss])
      bash "$SOLACE_DIR/install.sh"
      mkdir -p "$(dirname "$MARKER")"
      touch "$MARKER"
      ;;
  esac
  exit 0
fi

exec bash "$SOLACE_DIR/install.sh" "$@"
EOF

  cat >"$profile_hook" <<'EOF'
# Prompt once on interactive shell login if Solace is staged but not installed.
case $- in
  *i*) ;;
  *) return 0 2>/dev/null || exit 0 ;;
esac

command -v solace-postinstall >/dev/null 2>&1 || return 0 2>/dev/null || exit 0
solace-postinstall --prompt
EOF

  chmod 0755 "$postinstall"
  chmod 0644 "$profile_hook"
}

stage_solace_target() {
  require_target_mount
  copy_or_clone_solace
  fix_staged_solace_permissions
  install_first_login_prompt
  note "Solace staged into $TARGET/opt/solace"
  note "First-login prompt installed at $TARGET/etc/profile.d/solace-first-login.sh"
}

run_bootstrap_on_target() {
  header
  demo_notice
  say "Bootstrap a mounted Arch target"
  note "This mode assumes you have already installed or mounted Arch at $TARGET."
  note "It does not partition disks, format filesystems, or unlock LUKS."
  printf '\n'
  show_storage

  if [[ "$DEMO" == "1" ]]; then
    note "Would validate $TARGET, copy embedded Solace into $TARGET/opt/solace, install a first-login prompt, then optionally run arch-chroot $TARGET /opt/solace/install.sh."
    printf '\n'
    pause
    return 0
  fi

  confirm "Continue with target root at $TARGET?" || exit 0
  stage_solace_target

  confirm "Run /opt/solace/install.sh inside $TARGET now?" || exit 0
  arch-chroot "$TARGET" /opt/solace/install.sh
}

run_archinstall() {
  header
  demo_notice
  say "Launch archinstall"
  note "Use this for a fresh Arch install. After rebooting or mounting the target, run Solace bootstrap."
  printf '\n'
  if [[ "$DEMO" == "1" ]]; then
    note "Would launch archinstall for base Arch installation."
    printf '\n'
    pause
    return 0
  fi
  command -v archinstall >/dev/null 2>&1 || fail "archinstall is not installed."
  confirm "Start archinstall now?" || exit 0
  archinstall

  printf '\n'
  if mountpoint -q "$TARGET" && [[ -d "$TARGET/etc" ]]; then
    confirm "Archinstall finished. Stage Solace into $TARGET for first login?" || return 0
    stage_solace_target
  else
    note "Archinstall finished, but $TARGET is not mounted."
    note "Mount the new system at $TARGET later and choose 'Bootstrap mounted target at /mnt'."
    pause
  fi
}

run_calamares() {
  header
  demo_notice
  say "Launch experimental Calamares"
  note "This path is still under active development."
  printf '\n'
  if [[ "$DEMO" == "1" ]]; then
    note "Would launch solace-calamares."
    printf '\n'
    pause
    return 0
  fi
  confirm "Start Calamares now?" || exit 0
  solace-calamares
}

main() {
  while true; do
    header
    demo_notice
    note "Fastest stable path today: install/mount Arch first, then run the Solace bootstrap."
    printf '\n'

    local selection
    selection="$(choose \
      "Install guide" \
      "Bootstrap mounted target at /mnt" \
      "Launch archinstall" \
      "Launch experimental Calamares" \
      "Open shell")"

    case "$selection" in
      "Install guide") show_install_guide ;;
      "Bootstrap mounted target at /mnt") run_bootstrap_on_target ;;
      "Launch archinstall") run_archinstall ;;
      "Launch experimental Calamares") run_calamares ;;
      "Open shell"|"") exec "${SHELL:-/bin/bash}" ;;
      *) fail "Unknown selection: $selection" ;;
    esac
  done
}

main "$@"
