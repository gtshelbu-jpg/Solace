#mainApp {
    background-color: #0a1018;
    color: #eef6f7;
    font-size: 11pt;
}

#sidebarApp {
    background-color: #0a1018;
    color: #d8e4f0;
    border: none;
}

#logoApp {
    margin-top: 22px;
    margin-bottom: 18px;
}

QLabel {
    color: #eef6f7;
}

QCheckBox,
QRadioButton,
QGroupBox {
    color: #eef6f7;
}

QGroupBox {
    border: 1px solid rgba(216, 228, 240, 0.35);
    border-radius: 6px;
    margin-top: 12px;
    padding: 12px 10px 10px 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #ffffff;
}

QFrame,
QStackedWidget,
QScrollArea,
QWidget#centralWidget {
    background: transparent;
}

QPushButton {
    background-color: #ffffff;
    border: 1px solid #c9d2da;
    border-radius: 4px;
    color: #18222d;
    min-height: 28px;
    padding: 6px 16px;
}

QPushButton:hover {
    background-color: #eef5f4;
    border-color: #2c8478;
}

QPushButton:pressed {
    background-color: #dbecea;
}

QPushButton:disabled {
    background-color: #edf0f2;
    border-color: #d6dde2;
    color: #9aa7b2;
}

QLineEdit,
QComboBox,
QSpinBox,
QPlainTextEdit,
QTextEdit {
    background-color: #f7fafb;
    border: 1px solid #9fb1be;
    border-radius: 4px;
    color: #101820;
    padding: 5px 8px;
}

QComboBox QAbstractItemView,
QListView,
QTreeView,
QTableView {
    background-color: #f7fafb;
    color: #101820;
    border: 1px solid #9fb1be;
    selection-background-color: #2c8478;
    selection-color: #ffffff;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QPlainTextEdit:focus,
QTextEdit:focus {
    border-color: #2c8478;
}

QProgressBar {
    background-color: #d9e2e8;
    border: none;
    border-radius: 3px;
    height: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #2c8478;
    border-radius: 3px;
}
