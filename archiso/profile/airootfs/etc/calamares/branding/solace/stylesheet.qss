#mainApp {
    background-color: #f5f7f8;
    color: #18222d;
    font-size: 11pt;
}

#sidebarApp {
    background-color: #0a1018;
    color: #d8e4f0;
    border: none;
}

#logoApp {
    margin-top: 22px;
    margin-bottom: 18px;
}

QLabel {
    color: #18222d;
}

QPushButton {
    background-color: #ffffff;
    border: 1px solid #c9d2da;
    border-radius: 4px;
    color: #18222d;
    min-height: 28px;
    padding: 6px 16px;
}

QPushButton:hover {
    background-color: #eef5f4;
    border-color: #2c8478;
}

QPushButton:pressed {
    background-color: #dbecea;
}

QPushButton:disabled {
    background-color: #edf0f2;
    border-color: #d6dde2;
    color: #9aa7b2;
}

QLineEdit,
QComboBox,
QSpinBox,
QPlainTextEdit,
QTextEdit {
    background-color: #ffffff;
    border: 1px solid #c9d2da;
    border-radius: 4px;
    color: #18222d;
    padding: 5px 8px;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QPlainTextEdit:focus,
QTextEdit:focus {
    border-color: #2c8478;
}

QProgressBar {
    background-color: #d9e2e8;
    border: none;
    border-radius: 3px;
    height: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #2c8478;
    border-radius: 3px;
}
