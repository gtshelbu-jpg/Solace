#!/bin/bash

# solace:summary=Run the full Solace update pipeline
# solace:requires-sudo=true

set -e

# Ensure screensaver/sleep doesn't set in during updates
hyprctl dispatch tagwindow +noidle &>/dev/null || true

# Perform all update steps
solace-update-keyring
solace-update-available-reset
solace-update-system-pkgs
solace-migrate
solace-update-aur-pkgs
solace-update-orphan-pkgs
solace-hook post-update

solace-update-analyze-logs

solace-update-restart

# Re-enable screensaver/sleep after updates
hyprctl dispatch tagwindow -- -noidle &>/dev/null || true
