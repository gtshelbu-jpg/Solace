#!/bin/bash

# solace:summary=Pull the latest Solace git changes

set -e

if [[ ! -d $SOLACE_PATH/.git ]]; then
  echo "This is a copied-assets installation. Update your Solace source checkout and rerun its installer; runtime files are not a Git repository." >&2
  exit 1
fi

echo -e "\e[32mUpdate Solace\e[0m"

solace-update-time

# Suppress Hyprland config errors while git updates default config files mid-pull
hyprctl keyword debug:suppress_errors true &>/dev/null || true

git -C $SOLACE_PATH pull --autostash
git -C $SOLACE_PATH --no-pager diff --check || git -C $SOLACE_PATH reset --merge

hyprctl reload &>/dev/null || true
