#!/bin/bash

# solace:summary=Overwrite all the user configs in ~/.config/hypr with the Solace defaults.

extension=conf
[[ ! -f $HOME/.config/hypr/hyprland.lua ]] || extension=lua
for config in autostart bindings input looknfeel hyprland monitors; do
  solace-refresh-config "hypr/$config.$extension"
done
if [[ $extension == "conf" ]]; then
  bash "$SOLACE_PATH/install/config/detect-keyboard-layout.sh"
fi
