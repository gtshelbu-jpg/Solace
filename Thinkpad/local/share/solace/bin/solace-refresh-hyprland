#!/bin/bash

# solace:summary=Overwrite all the user configs in ~/.config/hypr with the Solace defaults.

solace-refresh-config hypr/autostart.conf
solace-refresh-config hypr/bindings.conf
solace-refresh-config hypr/input.conf
solace-refresh-config hypr/looknfeel.conf
solace-refresh-config hypr/hyprland.conf
solace-refresh-config hypr/monitors.conf
bash "$SOLACE_PATH/install/config/detect-keyboard-layout.sh"
