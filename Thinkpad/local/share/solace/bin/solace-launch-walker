#!/bin/bash

# solace:summary=Launch Walker and ensure its Elephant data provider is running

if ! command -v walker >/dev/null 2>&1; then
  notify-send -u critical "Walker is not installed" "Install the AUR package walker-bin, then retry Super + Space." 2>/dev/null
  echo "walker is not installed" >&2
  exit 127
fi

if [[ -z ${GTK_THEME:-} ]]; then
  if [[ -f "$HOME/.config/solace/current/theme/light.mode" ]]; then
    export GTK_THEME=Adwaita
  else
    export GTK_THEME=Adwaita:dark
  fi
fi

if command -v elephant >/dev/null 2>&1 && ! pgrep -x elephant > /dev/null; then
  setsid uwsm-app -- elephant &
fi

# Ensure walker service is running
if ! pgrep -f "walker --gapplication-service" > /dev/null; then
  setsid uwsm-app -- env GSK_RENDERER=cairo walker --gapplication-service &
fi

exec walker --width 644 --maxheight 300 --minheight 300 "$@"
