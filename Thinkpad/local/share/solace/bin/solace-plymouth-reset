#!/bin/bash

# solace:summary=Restore the default Solace Plymouth boot theme and SDDM login screen
# solace:requires-sudo=true

theme_dir="/usr/share/plymouth/themes/solace"

sudo find ~/.local/share/solace/default/plymouth -maxdepth 1 -type f -exec cp -t "$theme_dir/" {} +
sudo plymouth-set-default-theme solace

if solace-cmd-present limine-mkinitcpio; then
  sudo limine-mkinitcpio
else
  sudo mkinitcpio -P
fi

solace-refresh-sddm
