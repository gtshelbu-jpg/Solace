#!/bin/bash

# solace:summary=Reinstall all default Solace packages from the stable channel
# solace:requires-sudo=true

set -e

# Reinstall all default Solace packages from the stable channel and downgrade any packages that are too new.

# Set the package repository to the stable mirrors
solace-refresh-pacman

# Downgrade any packages to the stable setup
sudo pacman -Suu --noconfirm

# Ensure all packages are installed
mapfile -t packages < <(grep -v '^#' "$SOLACE_PATH/install/solace-base.packages" | grep -v '^$')
sudo pacman -Syu --noconfirm --needed "${packages[@]}"
