#!/bin/bash

# solace:summary=Launch or focus on a given web app identified by the window-pattern.
# solace:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: solace-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="solace-launch-webapp $@"

exec solace-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
