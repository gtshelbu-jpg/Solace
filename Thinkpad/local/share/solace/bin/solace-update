#!/bin/bash

# solace:summary=Update Solace and system packages
# solace:args=[-y]
# solace:examples=solace update | solace update -y
# solace:requires-sudo=true

set -e

# Run the update inside a PTY so pacman/yay keep showing download progress
# while still logging the full session for later analysis.
if [[ -z $SOLACE_UPDATE_LOGGED ]]; then
  script_command=$(printf '%q ' "$0" "$@")
  exec env SOLACE_UPDATE_LOGGED=1 script -qefc "$script_command" "/tmp/solace-update.log"
fi

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\n\nIf you need assistance, get help from the community at https://solace.org/discord\033[0m"' ERR

if [[ $1 == "-y" ]] || solace-update-confirm; then
  solace-snapshot create || (($? == 127))
  solace-update-git
  solace-update-perform
fi
