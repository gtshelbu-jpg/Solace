#!/bin/bash

# solace:summary=Refresh the current theme from its templates.

THEME_NAME_PATH="$HOME/.config/solace/current/theme.name"

if [[ -f $THEME_NAME_PATH ]]; then
  theme_name="$(cat "$THEME_NAME_PATH")"
  if [[ "$theme_name" == "aether" ]]; then
    solace-aether-sync
  else
    SOLACE_THEME_SKIP_BACKGROUND=1 solace-theme-set "$theme_name"
  fi
fi
