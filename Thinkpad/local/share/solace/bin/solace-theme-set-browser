#!/bin/bash

# solace:summary=Apply the current theme color/mode to supported browsers
# solace:hidden=true

SOLACE_PATH="${SOLACE_PATH:-$HOME/.local/share/solace}"
CHROMIUM_THEME="$HOME/.config/solace/current/theme/chromium.theme"
FIREFOX_POLICY_SCHEME=0
FIREFOX_SYSTEM_DARK=1

if [[ -f "$HOME/.config/solace/current/theme/light.mode" ]]; then
  FIREFOX_POLICY_SCHEME=1
  FIREFOX_SYSTEM_DARK=0
fi

if [[ -f $CHROMIUM_THEME ]]; then
  THEME_RGB_COLOR=$(<$CHROMIUM_THEME)
  THEME_HEX_COLOR=$(printf '#%02x%02x%02x' ${THEME_RGB_COLOR//,/ })
else
  # Use a default, neutral grey if theme doesn't have a color
  THEME_HEX_COLOR="#1c2027"
fi

set_browser_policy() {
  local policy_dir="$1"
  local policy_file="$policy_dir/color.json"
  local tmp

  [[ -d $policy_dir ]] || return
  tmp="$(mktemp)"
  printf '{"BrowserThemeColor": "%s", "BrowserColorScheme": "device"}\n' "$THEME_HEX_COLOR" >"$tmp"

  if [[ -w $policy_dir ]]; then
    install -m 0644 "$tmp" "$policy_file"
  else
    sudo install -m 0644 "$tmp" "$policy_file"
  fi

  rm -f "$tmp"
}

set_firefox_policy() {
  local distribution_dir="$1"
  local policy_file="$distribution_dir/policies.json"
  local tmp

  [[ -d $distribution_dir ]] || return
  tmp="$(mktemp)"

  if [[ -f $policy_file ]]; then
    jq \
      --argjson color_scheme "$FIREFOX_POLICY_SCHEME" \
      --argjson system_dark "$FIREFOX_SYSTEM_DARK" \
      '
        .policies //= {} |
        .policies.Preferences //= {} |
        .policies.Preferences["layout.css.prefers-color-scheme.content-override"] = {"Value": $color_scheme, "Status": "default"} |
        .policies.Preferences["ui.systemUsesDarkTheme"] = {"Value": $system_dark, "Status": "default"} |
        .policies.Preferences["zen.view.window.scheme"] = {"Value": $color_scheme, "Status": "default"}
      ' "$policy_file" >"$tmp"
  else
    jq -n \
      --argjson color_scheme "$FIREFOX_POLICY_SCHEME" \
      --argjson system_dark "$FIREFOX_SYSTEM_DARK" \
      '{
        "policies": {
          "Preferences": {
            "layout.css.prefers-color-scheme.content-override": {"Value": $color_scheme, "Status": "default"},
            "ui.systemUsesDarkTheme": {"Value": $system_dark, "Status": "default"},
            "zen.view.window.scheme": {"Value": $color_scheme, "Status": "default"}
          }
        }
      }' >"$tmp"
  fi

  if [[ -w $distribution_dir ]]; then
    install -m 0644 "$tmp" "$policy_file"
  else
    sudo install -m 0644 "$tmp" "$policy_file"
  fi

  rm -f "$tmp"
}

refresh_running_browser() {
  local process="$1"
  local command="$2"
  local pgrep_args="${3:--x}"
  local cmd_present="$SOLACE_PATH/bin/solace-cmd-present"

  if [[ -x "$cmd_present" ]]; then
    "$cmd_present" "$command" || return
  elif ! command -v "$command" >/dev/null 2>&1; then
    return
  fi

  if pgrep $pgrep_args "$process" >/dev/null; then
    "$command" --refresh-platform-policy --no-startup-window &>/dev/null
  fi
}

set_browser_policy /etc/chromium/policies/managed
refresh_running_browser chromium chromium

set_browser_policy /etc/opt/chrome/policies/managed
refresh_running_browser chrome google-chrome-stable || refresh_running_browser chrome google-chrome

set_browser_policy /etc/opt/edge/policies/managed
refresh_running_browser msedge microsoft-edge-stable

set_browser_policy /etc/brave/policies/managed
refresh_running_browser brave brave
refresh_running_browser brave-origin-beta brave-origin-beta -f

set_firefox_policy /usr/lib/firefox/distribution
set_firefox_policy /opt/zen-browser-bin/distribution
