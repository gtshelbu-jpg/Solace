#!/bin/bash

# solace:summary=Display brightness level using SwayOSD on the current monitor.
# solace:args=<0-100>
# solace:examples=solace swayosd brightness 0 | solace swayosd brightness 50 | solace swayosd brightness 100

percent="$1"

progress="$(awk -v p="$percent" 'BEGIN{printf "%.2f", p/100}')"
[[ $progress == "0.00" ]] && progress="0.01"

solace-swayosd-client \
  --custom-icon display-brightness-symbolic \
  --custom-progress "$progress" \
  --custom-progress-text "${percent}%"
