#!/usr/bin/env bash

# solace:summary=Install and run chkrootkit as a background first-run system check.

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/solace/security-checks"
STATUS_FILE="$STATE_DIR/chkrootkit.status"
LOG_FILE="$STATE_DIR/chkrootkit.log"
PID_FILE="$STATE_DIR/chkrootkit.pid"

mkdir -p "$STATE_DIR"

write_status() {
  local state="$1"
  local message="$2"
  {
    printf 'state=%q\n' "$state"
    printf 'message=%q\n' "$message"
    printf 'updated_at=%q\n' "$(date -Is)"
    printf 'log=%q\n' "$LOG_FILE"
  } >"$STATUS_FILE"
}

running() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid="$(<"$PID_FILE")"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

install_chkrootkit() {
  if command -v chkrootkit >/dev/null 2>&1; then
    return 0
  fi

  write_status "installing" "Installing chkrootkit from the AUR"

  if command -v paru >/dev/null 2>&1; then
    paru -S --needed --noconfirm chkrootkit
  elif command -v yay >/dev/null 2>&1; then
    yay -S --needed --noconfirm chkrootkit
  else
    return 2
  fi
}

run_scan() {
  : >"$LOG_FILE"
  write_status "running" "Running chkrootkit scan"

  if sudo -n true 2>/dev/null; then
    sudo -n chkrootkit >"$LOG_FILE" 2>&1
  else
    {
      printf 'Solace note: passwordless sudo was not available, so chkrootkit ran without root privileges.\n'
      printf 'Some checks may be incomplete.\n\n'
      chkrootkit
    } >"$LOG_FILE" 2>&1
  fi
}

classify_result() {
  if grep -Eiq 'INFECTED|Vulnerable|WARNING|not tested|unable to|permission denied' "$LOG_FILE"; then
    write_status "warning" "Review chkrootkit output"
  else
    write_status "pass" "No rootkit indicators found"
  fi
}

worker() {
  trap 'rm -f "$PID_FILE"' EXIT
  printf '%s\n' "$BASHPID" >"$PID_FILE"

  if ! install_chkrootkit >"$LOG_FILE" 2>&1; then
    write_status "failed" "Could not install chkrootkit from the AUR"
    exit 0
  fi

  if ! run_scan; then
    write_status "failed" "chkrootkit scan failed"
    exit 0
  fi

  classify_result
}

case "${1:-start}" in
  start)
    if running; then
      exit 0
    fi
    if [[ -f "$STATUS_FILE" ]]; then
      # Keep completed results for the current boot/session unless explicitly rerun.
      # shellcheck disable=SC1090
      source "$STATUS_FILE" 2>/dev/null || true
      case "${state:-}" in
        pass|warning|failed) exit 0 ;;
      esac
    fi
    write_status "queued" "Queued chkrootkit scan"
    (worker) >/dev/null 2>&1 &
    ;;
  rerun)
    rm -f "$STATUS_FILE" "$LOG_FILE" "$PID_FILE"
    write_status "queued" "Queued chkrootkit scan"
    (worker) >/dev/null 2>&1 &
    ;;
  status)
    if [[ -f "$STATUS_FILE" ]]; then
      cat "$STATUS_FILE"
    else
      write_status "pending" "chkrootkit has not run yet"
      cat "$STATUS_FILE"
    fi
    ;;
  log)
    [[ -f "$LOG_FILE" ]] && cat "$LOG_FILE"
    ;;
  *)
    echo "Usage: solace-security-chkrootkit [start|rerun|status|log]" >&2
    exit 1
    ;;
esac
