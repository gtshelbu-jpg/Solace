#!/bin/bash

# solace:summary=Shut down after closing application windows
# solace:examples=solace shutdown | solace system shutdown
# solace:aliases=solace shutdown

solace-state clear re*-required

# Schedule the shutdown to happen after closing windows (detached from terminal)
nohup bash -c "sleep 2 && systemctl poweroff --no-wall" >/dev/null 2>&1 &

# Now close all windows
solace-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
