#!/bin/bash

# solace:summary=Lock the computer and keep the lock screen visible
# solace:group=system
# solace:name=lock
# solace:examples=solace system lock

locked="$(hyprctl locked 2>/dev/null)"

if [[ $locked != "true" ]] && pidof hyprlock >/dev/null; then
  pkill -x hyprlock
fi

if [[ $locked != "true" ]]; then
  (
    hyprlock --quiet
    solace-system-wake
  ) &
fi

# Set keyboard layout to default (first layout)
hyprctl switchxkblayout all 0 > /dev/null 2>&1

# Ensure 1password is locked
if pgrep -x "1password" >/dev/null; then
  1password --lock &
fi

# Keep all displays powered while locked so the Solace lock screen remains
# visible on both the built-in panel and DisplayLink outputs.
