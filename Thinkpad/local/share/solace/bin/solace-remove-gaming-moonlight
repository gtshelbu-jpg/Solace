#!/bin/bash

# solace:summary=Remove Moonlight and its configs and caches.
# solace:requires-sudo=true

set -e

solace-pkg-drop moonlight-qt

rm -rf \
  "$HOME/.config/Moonlight Game Streaming Project" \
  "$HOME/.cache/Moonlight Game Streaming Project"

echo ""
echo "Moonlight and its data have been removed."
