#!/bin/bash

# solace:summary=List available themes
# solace:examples=solace theme list | solace theme set "Tokyo Night"

{
  find ~/.config/solace/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n' 2>/dev/null
  find "$SOLACE_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null
} | sort -u | while read -r name; do
  echo "$name" | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
done
