#!/usr/bin/env bash

# solace:summary=Show the first-login Solace welcome guide.

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/solace"
DONE_MARKER="$STATE_DIR/welcome.done"
FORCE=0
DISPLAY_ONLY=0
PLAIN=0
SOLACE_HOME="${SOLACE_PATH:-$HOME/.local/share/solace}"
DOCS_DIR="${SOLACE_DOCS_DIR:-$SOLACE_HOME/default/docs/welcome}"
LOGO_PATH="${SOLACE_LOGO_PATH:-}"

for arg in "$@"; do
  case "$arg" in
    --force) FORCE=1 ;;
    --first-run) ;;
    --display) DISPLAY_ONLY=1 ;;
    --plain) PLAIN=1 ;;
  esac
done

mkdir -p "$STATE_DIR"

if [[ "$FORCE" -eq 0 && "$DISPLAY_ONLY" -eq 0 && -f "$DONE_MARKER" ]]; then
  exit 0
fi

find_logo_path() {
  local candidate

  if [[ -n "$LOGO_PATH" && -f "$LOGO_PATH" ]]; then
    printf '%s\n' "$LOGO_PATH"
    return 0
  fi

  for candidate in \
    "$SOLACE_HOME/logo.txt" \
    "$SOLACE_HOME/default/sddm/solace/logo.txt" \
    "$HOME/.config/solace/branding/about.txt" \
    "$HOME/.config/solace/branding/screensaver.txt"; do
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

launch_terminal() {
  if command -v xdg-terminal-exec >/dev/null 2>&1; then
    [[ "$FORCE" -eq 1 ]] || touch "$DONE_MARKER"
    exec setsid uwsm-app -- env SOLACE_WELCOME_IN_TERMINAL=1 \
      xdg-terminal-exec --app-id=org.solace.welcome --title="Welcome to Solace" \
      -e solace-welcome --display
  fi

  [[ "$FORCE" -eq 1 ]] || touch "$DONE_MARKER"
  notify-send "Welcome to Solace" "Super + Space opens apps. Super + K opens keybindings." -u normal 2>/dev/null || true
}

show_plain() {
  local logo_path
  logo_path="$(find_logo_path || true)"
  if [[ -n "$logo_path" ]]; then
    echo
    cat "$logo_path"
  fi

  cat <<'EOF'

Welcome to Solace

Fast, focused Arch + Hyprland with a few friendly handrails.

Start here
  Super + Space        App launcher
  Super + Alt + Space  Solace menu
  Super + K            Search keybindings
  Super + Enter        Terminal
  Super + Escape       System menu

Learn
  Run `solace-welcome --force` any time to reopen this guide.
  Open Solace Menu > Learn > Solace to browse it from the desktop.

EOF
}

theme_color() {
  local key="$1"
  local fallback="$2"
  local colors="$HOME/.config/solace/current/theme/colors.toml"

  if [[ -f "$colors" ]]; then
    local value
    value="$(sed -n "s/^${key}[[:space:]]*=[[:space:]]*[\"']\\([^\"']*\\)[\"'].*/\\1/p" "$colors" | head -n1)"
    [[ -n "$value" ]] && {
      printf '%s\n' "$value"
      return
    }
  fi

  printf '%s\n' "$fallback"
}

print_header() {
  local accent foreground muted background logo_path
  accent="$(theme_color accent "#7b5daf")"
  foreground="$(theme_color foreground "#ffffff")"
  muted="$(theme_color muted "#9bb8ff")"
  background="$(theme_color background "#00020a")"
  logo_path="$(find_logo_path || true)"

  if [[ -n "$logo_path" ]]; then
    gum style --foreground "$accent" --margin "1 0 1 2" "$(<"$logo_path")"
    echo
  fi

  gum style \
    --foreground "$foreground" \
    --background "$background" \
    --border-foreground "$accent" \
    --border rounded \
    --padding "1 3" \
    --margin "1" \
    "Welcome to Solace" \
    "" \
    "Fast, focused Arch + Hyprland with a few friendly handrails."

  gum style --foreground "$muted" "Pick a topic, read what you need, and wander back any time."
  echo
}

doc_path_for_label() {
  case "$1" in
    *Start*) printf '%s/start-here.md\n' "$DOCS_DIR" ;;
    *Keyboard*) printf '%s/keyboard.md\n' "$DOCS_DIR" ;;
    *System*) printf '%s/system.md\n' "$DOCS_DIR" ;;
    *Apps*) printf '%s/apps.md\n' "$DOCS_DIR" ;;
    *Displays*) printf '%s/displays.md\n' "$DOCS_DIR" ;;
    *Troubleshooting*) printf '%s/troubleshooting.md\n' "$DOCS_DIR" ;;
    *) return 1 ;;
  esac
}

show_doc() {
  local label="$1"
  local path
  path="$(doc_path_for_label "$label")" || return 0

  clear 2>/dev/null || true
  print_header
  if [[ -f "$path" ]]; then
    gum format <"$path"
  else
    gum style --foreground "#f7768e" "Missing documentation page:"
    echo "$path"
  fi
  echo
  gum confirm --affirmative "Back" --negative "Close" "Return to the guide?" || exit 0
}

show_gum() {
  local options choice
  options=$'Start Here\nKeyboard And Navigation\nSystem Care\nApps And Defaults\nDisplays And Docks\nTroubleshooting\nClose'

  while true; do
    clear 2>/dev/null || true
    print_header

    gum format <<'EOF'
## Quick keys

- `Super + Space`: launch apps
- `Super + Alt + Space`: open the Solace menu
- `Super + K`: search keybindings
- `Super + Enter`: open a terminal
EOF

    echo
    choice="$(printf '%s\n' "$options" | gum choose --height 10 --header "Open a page")" || exit 0
    [[ "$choice" == "Close" || -z "$choice" ]] && exit 0
    show_doc "$choice"
  done
}

if [[ "${SOLACE_WELCOME_IN_TERMINAL:-0}" != "1" && "$DISPLAY_ONLY" -eq 0 ]]; then
  launch_terminal
fi

[[ "$FORCE" -eq 1 ]] || touch "$DONE_MARKER"

clear 2>/dev/null || true
if [[ "$PLAIN" -eq 0 ]] && command -v gum >/dev/null 2>&1; then
  show_gum
else
  show_plain
fi

echo
read -r -p "Press Enter to close Solace welcome..."
