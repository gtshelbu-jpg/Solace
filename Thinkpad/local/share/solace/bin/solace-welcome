#!/usr/bin/env bash

# solace:summary=Show the first-login Solace welcome guide.

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/solace"
DONE_MARKER="$STATE_DIR/welcome.done"
FORCE=0
DISPLAY_ONLY=0

for arg in "$@"; do
  case "$arg" in
    --force) FORCE=1 ;;
    --first-run) ;;
    --display) DISPLAY_ONLY=1 ;;
  esac
done

mkdir -p "$STATE_DIR"

if [[ "$FORCE" -eq 0 && -f "$DONE_MARKER" ]]; then
  exit 0
fi

launch_terminal() {
  if command -v xdg-terminal-exec >/dev/null 2>&1; then
    [[ "$FORCE" -eq 1 ]] || touch "$DONE_MARKER"
    exec setsid uwsm-app -- env SOLACE_WELCOME_IN_TERMINAL=1 \
      xdg-terminal-exec --app-id=org.solace.welcome --title="Welcome to Solace" \
      -e solace-welcome --display
  fi

  [[ "$FORCE" -eq 1 ]] || touch "$DONE_MARKER"
  notify-send "Welcome to Solace" "Super + Space opens apps. Super + K opens keybindings." -u normal 2>/dev/null || true
}

show_plain() {
  cat <<'EOF'

Welcome to Solace

A personal Arch workflow with the sharp edges filed down just enough.

Start here
  Super + Space      App launcher
  Super + K          Search keybindings
  Super + Enter      Terminal
  Super + Shift + F  Files
  Super + Alt + Space Solace menu
  Super + Escape     System menu

Fresh install notes
  Walker is your launcher and menu search surface.
  Waybar, SDDM, Plymouth, GTK apps, and VS Code are themed by Solace defaults.
  NetworkManager, iwd, and impala are set up for Wi-Fi.

EOF
}

show_gum() {
  gum style \
    --foreground "#d8e2ff" \
    --border-foreground "#5f86d9" \
    --border rounded \
    --padding "1 3" \
    --margin "1" \
    "Solace" \
    "" \
    "A personal Arch workflow with the sharp edges filed down just enough."

  gum style --foreground "#9bb8ff" "Start here"
  gum format <<'EOF'
- `Super + Space` opens Walker, the app launcher.
- `Super + K` searches every Hyprland keybinding.
- `Super + Enter` opens a terminal.
- `Super + Shift + F` opens Files.
- `Super + Alt + Space` opens the Solace menu.
- `Super + Escape` opens the system menu.
EOF

  echo
  gum style --foreground "#9bb8ff" "Fresh install notes"
  gum format <<'EOF'
- Waybar, SDDM, Plymouth, GTK apps, and VS Code are themed by Solace defaults.
- NetworkManager, iwd, and impala are set up for Wi-Fi.
- DisplayLink support is installed and enabled when the packages are present.
EOF
}

if [[ "${SOLACE_WELCOME_IN_TERMINAL:-0}" != "1" && "$DISPLAY_ONLY" -eq 0 ]]; then
  launch_terminal
fi

[[ "$FORCE" -eq 1 ]] || touch "$DONE_MARKER"

clear 2>/dev/null || true
if command -v gum >/dev/null 2>&1; then
  show_gum
else
  show_plain
fi

echo
read -r -p "Press Enter to close Solace welcome..."
