#!/bin/bash

# solace:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# solace:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
solace-pkg-add heroic-games-launcher-bin
solace-install-gaming-gpu-lib32

setsid gtk-launch heroic >/dev/null 2>&1 &
