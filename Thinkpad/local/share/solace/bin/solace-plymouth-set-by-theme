#!/bin/bash

# solace:summary=Set the Plymouth boot theme from an Solace theme
# solace:args=<theme-name>
# solace:requires-sudo=true

# Resolve a theme by name and apply its unlock.png + colors.toml as the
# Plymouth boot screen via solace-plymouth-set.

if [[ $# -ne 1 ]]; then
  echo "Usage: solace-plymouth-set-by-theme <theme-name>" >&2
  exit 1
fi

theme=$1

if [[ -d ~/.config/solace/themes/$theme ]]; then
  theme_dir=~/.config/solace/themes/$theme
else
  theme_dir="$SOLACE_PATH/themes/$theme"
fi

bg=$(awk -F'"' '/^background/{print $2}' "$theme_dir/colors.toml")
text=$(awk -F'"' '/^foreground/{print $2}' "$theme_dir/colors.toml")

exec solace-plymouth-set "$bg" "$text" "$theme_dir/unlock.png"
