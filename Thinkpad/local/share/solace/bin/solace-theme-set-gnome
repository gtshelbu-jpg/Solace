#!/bin/bash

# solace:summary=Apply the current theme to GNOME color mode and icon settings
# solace:hidden=true

set_gsetting() {
  gsettings set org.gnome.desktop.interface "$1" "$2" >/dev/null 2>&1 || true
}

set_schema_gsetting() {
  local schema="$1"
  local key="$2"
  local value="$3"

  gsettings set "$schema" "$key" "$value" >/dev/null 2>&1 || true
}

write_gtk_settings() {
  local prefer_dark="$1"
  local gtk_theme="$2"
  local icon_theme="$3"

  mkdir -p "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"
  for settings in "$HOME/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini"; do
    cat >"$settings" <<EOF
[Settings]
gtk-application-prefer-dark-theme=$prefer_dark
gtk-theme-name=$gtk_theme
gtk-icon-theme-name=$icon_theme
EOF
  done
}

icon_theme_exists() {
  local theme="$1"

  [[ -d "$HOME/.icons/$theme" ]] ||
    [[ -d "$HOME/.local/share/icons/$theme" ]] ||
    [[ -d "/usr/share/icons/$theme" ]]
}

resolve_icon_theme() {
  local requested="$1"

  if icon_theme_exists "$requested"; then
    printf '%s\n' "$requested"
  elif icon_theme_exists Adwaita; then
    printf 'Adwaita\n'
  else
    printf 'hicolor\n'
  fi
}

set_nautilus_defaults() {
  set_schema_gsetting org.gnome.nautilus.preferences default-folder-viewer "'list-view'"
  set_schema_gsetting org.gnome.nautilus.preferences default-sort-order "'name'"
  set_schema_gsetting org.gnome.nautilus.preferences default-sort-in-reverse-order false
  set_schema_gsetting org.gnome.nautilus.list-view default-zoom-level "'medium'"
  set_schema_gsetting org.gnome.nautilus.icon-view default-zoom-level "'small'"

  pkill -x nautilus >/dev/null 2>&1 || true
}

# Change gnome icon theme color
GNOME_ICONS_THEME=~/.config/solace/current/theme/icons.theme
if [[ -f $GNOME_ICONS_THEME ]]; then
  icon_theme="$(resolve_icon_theme "$(<"$GNOME_ICONS_THEME")")"
else
  icon_theme="$(resolve_icon_theme Yaru-blue)"
fi

if [[ -f ~/.config/solace/current/theme/light.mode ]]; then
  gtk_theme_env="Adwaita"
  set_gsetting color-scheme "prefer-light"
  set_gsetting gtk-theme "Adwaita"
  set_gsetting gtk-application-prefer-dark-theme false
  write_gtk_settings false "Adwaita" "$icon_theme"
else
  gtk_theme_env="Adwaita:dark"
  set_gsetting color-scheme "prefer-dark"
  set_gsetting gtk-theme "Adwaita-dark"
  set_gsetting gtk-application-prefer-dark-theme true
  write_gtk_settings true "Adwaita-dark" "$icon_theme"
fi

set_gsetting icon-theme "$icon_theme"
set_nautilus_defaults

if command -v systemctl >/dev/null 2>&1; then
  systemctl --user set-environment "GTK_THEME=$gtk_theme_env" >/dev/null 2>&1 || true
fi

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  GTK_THEME="$gtk_theme_env" dbus-update-activation-environment --systemd GTK_THEME >/dev/null 2>&1 || true
fi

if command -v hyprctl >/dev/null 2>&1; then
  hyprctl setenv GTK_THEME "$gtk_theme_env" >/dev/null 2>&1 || true
fi
