#!/bin/bash

# solace:summary=Set the Solace channel, which dictates what git branch and package repository is used.
# solace:args=<stable|rc|edge|dev>
# solace:requires-sudo=true

if (($# == 0)); then
  echo "Usage: solace-channel-set [stable|rc|edge|dev]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable") solace-branch-set "master" && solace-refresh-pacman "stable" ;;
"rc") solace-branch-set "rc" && solace-refresh-pacman "rc" ;;
"edge") solace-branch-set "master" && solace-refresh-pacman "edge" ;;
"dev") solace-branch-set "dev" && solace-refresh-pacman "edge" ;;
*) echo "Unknown channel: $channel"; exit 1; ;;
esac

solace-update -y
