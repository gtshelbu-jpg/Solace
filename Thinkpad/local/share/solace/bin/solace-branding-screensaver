#!/bin/bash

# solace:summary=Edit, set, or reset screensaver branding
# solace:group=branding
# solace:name=screensaver
# solace:args=<image|text|reset>
# solace:examples=solace branding screensaver image | solace branding screensaver text | solace branding screensaver reset

set -euo pipefail

case "${1:-}" in
image)
  image=$(solace-menu-file "Logo image" "$HOME" "svg png")
  if [[ -n $image ]] && solace-transcode-ascii "$image" ~/.config/solace/branding/screensaver.txt; then
    solace-launch-screensaver force >/dev/null 2>&1
  fi
  ;;
text)
  solace-launch-editor ~/.config/solace/branding/screensaver.txt >/dev/null 2>&1 && solace-launch-screensaver force >/dev/null 2>&1
  ;;
reset)
  cp "$SOLACE_PATH/logo.txt" ~/.config/solace/branding/screensaver.txt && solace-launch-screensaver force >/dev/null 2>&1
  ;;
*)
  echo "Usage: solace-branding-screensaver <image|text|reset>" >&2
  exit 1
  ;;
esac
