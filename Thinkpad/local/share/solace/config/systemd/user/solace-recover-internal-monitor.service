[Unit]
Description=Recover the internal monitor toggle when no external display is connected
Before=graphical-session-pre.target
ConditionPathExists=%h/.local/state/solace/toggles/hypr/internal-monitor-disable.conf

[Service]
Type=oneshot
ExecStart=%h/.local/share/solace/bin/solace-hw-recover-internal-monitor

[Install]
WantedBy=graphical-session-pre.target
