# Changes require a restart to take effect.

# Ensure Solace bins are in the path
export SOLACE_PATH=$HOME/.local/share/solace
export PATH=$SOLACE_PATH/bin:$PATH:$HOME/.local/bin

# Set default terminal and editor
source ~/.config/uwsm/default

# Do not force GTK_THEME globally. GTK4/libadwaita apps such as Nautilus load
# user CSS more reliably when the color-scheme hint and gtk.css are allowed to
# do their work without an explicit Adwaita theme override.
unset GTK_THEME

# Activate mise if present on the system
solace-cmd-present mise && eval "$(mise activate bash --shims)"
