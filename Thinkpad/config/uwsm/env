# Changes require a restart to take effect.

# Ensure Solace bins are in the path
export SOLACE_PATH=$HOME/.local/share/solace
export PATH=$SOLACE_PATH/bin:$PATH

# Set default terminal and editor
source ~/.config/uwsm/default

# Older GTK apps, including virt-manager, often ignore the portal color-scheme
# hint and only follow GTK_THEME.
if [[ -f ~/.config/solace/current/theme/light.mode ]]; then
  export GTK_THEME="${GTK_THEME:-Adwaita}"
else
  export GTK_THEME="${GTK_THEME:-Adwaita:dark}"
fi

# Activate mise if present on the system
solace-cmd-present mise && eval "$(mise activate bash --shims)"
